msgid "SKU"
msgstr "SKU"

#: class-knowledge.php
msgid "Categories"
msgstr "Categorías"

#: class-knowledge.php
msgid "Price"
msgstr "Precio"

#: class-knowledge.php
msgid "In stock"
msgstr "Hay existencias"

#: class-knowledge.php
msgid "Out of stock"
msgstr "Agotado"

